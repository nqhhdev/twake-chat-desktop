// Small building blocks, mirroring src/ds of the web app.
import { Theme } from "theme.slint";

/// A line of a suggestion list: the composer's (emoji, @person, #room, /command) and
/// the quick switcher's.
// A change of the composer's text: its new text and selection (byte offsets); `ok`
// false when nothing changes.
export struct TextChange {
    ok: bool,
    text: string,
    from: int,
    to: int,
}

// What the link dialog starts from: the range it replaces, its text and address.
export struct LinkTarget {
    from: int,
    to: int,
    text: string,
    url: string,
}

export struct Suggestion {
    icon: string,
    label: string,
    detail: string,
}

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 40px;
    in property <image> picture;
    in property <bool> has-picture;
    width: size;
    height: size;
    border-radius: size / 2;
    background: tint;
    clip: true;
    accessible-role: none;
    if has-picture: Image {
        width: size;
        height: size;
        source: picture;
        image-fit: cover;
    }
    if !has-picture: Text {
        text: initials;
        color: white;
        font-size: size * 0.4;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Badge inherits Rectangle {
    in property <string> label;
    in property <bool> strong: true;
    height: 20px;
    width: max(20px, t.preferred-width + 12px);
    border-radius: 10px;
    background: strong ? Theme.primary : Theme.line;
    t := Text {
        text: label;
        color: strong ? Theme.on-primary : Theme.text-secondary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: !enabled ? Theme.line : touch.has-hover ? Theme.primary-dark : Theme.primary;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { clicked(); } }
    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
    Text {
        text: label;
        color: enabled ? Theme.on-primary : Theme.text-secondary;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The icons of the OS (SF Symbols on macOS, src/icons.rs), set at start-up; empty
// where the OS has none, and an Icon then shows its emoji.
export global Icons {
    in property <image> bell;
    in property <image> chats;
    in property <image> lock;
    in property <image> pin;
    in property <image> phone;
    in property <image> video;
    in property <image> mic;
    in property <image> send;
    in property <image> plus;
    in property <image> mic-off;
    in property <image> screen;
    in property <image> pip;
    in property <image> fullscreen;
    in property <image> move;
    in property <image> attach;
    in property <image> poll;
    in property <image> emoji;
    in property <image> close;
    in property <image> reply;
    in property <image> thread;
    in property <image> bookmark;
    in property <image> edit;
    in property <image> delete;
    in property <image> play;
    in property <image> pause;
    in property <image> file;
    in property <image> film;
    in property <image> music;
    in property <image> clock;
    in property <image> check;
    in property <image> link;
    in property <image> quote;
    in property <image> bullets;
}

// An icon of the OS in a colour of the theme, or its emoji where the OS has none.
export component Icon {
    in property <image> source;
    in property <string> fallback;
    in property <color> color: Theme.text-secondary;
    in property <length> size: 16px;
    width: self.size;
    height: self.size;
    if root.source.width > 0: Image {
        width: root.size;
        height: root.size;
        source: root.source;
        colorize: root.color;
        image-fit: contain;
    }
    if root.source.width == 0: Text {
        text: root.fallback;
        font-size: root.size * 0.85;
        color: root.color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TextButton inherits Rectangle {
    in property <string> label;
    // An icon before the label (Icons), none by default; `fallback` is its emoji
    // where the OS has none
    in property <image> icon;
    in property <string> fallback;
    callback clicked();
    height: 32px;
    width: row.preferred-width;
    // A text button of twake-mui: a pill
    border-radius: self.height / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.icon.width > 0: Image {
            width: 16px;
            source: root.icon;
            colorize: Theme.primary;
            image-fit: contain;
        }
        Text {
            text: root.icon.width > 0 || root.fallback == "" ? label : root.fallback + " " + label;
            color: Theme.primary;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A labelled single-line field.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <bool> password;
    in-out property <string> text;
    callback accepted();
    spacing: 4px;
    Text { text: label; color: Theme.text-secondary; font-size: 12px; }
    Rectangle {
        height: 40px;
        border-radius: 8px;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.primary : Theme.line;
        background: Theme.background;
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            text <=> root.text;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            input-type: password ? InputType.password : InputType.text;
            accessible-label: label;
            accepted => { root.accepted(); }
        }
    }
}

// A page of the PDF viewer (src/pdf.rs): its height for a width of 1, and its picture
// once drawn.
export struct PdfPage {
    ratio: float,
    image: image,
    ready: bool,
}
