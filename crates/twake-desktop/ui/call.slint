// The call of a room (web `CallStage`, `CallView`): the grid of the people, each tile as
// large as fits (16:9), or a shared screen on the stage with the people in a row under
// it, and the controls under them.
import { Theme } from "theme.slint";
import { Avatar, Icon, Icons } from "parts.slint";

export struct CallTileRow {
    identity: string,
    screen: bool,
    name: string,
    initials: string,
    tint: color,
    local: bool,
    has-video: bool,
    muted: bool,
    speaking: bool,
    frame: image,
    ready: bool,
}

// One device of a menu, the one in use checked (web `MenuRadio`)
export struct DeviceRow {
    id: string,
    label: string,
    checked: bool,
}

// The devices of one kind: "microphone", "speaker" or "camera" (web `CallDeviceList`)
export struct DeviceSection {
    kind: string,
    title: string,
    rows: [DeviceRow],
}

// The arrow beside a control, which opens its devices (web `CallView`, `CallDeviceMenu`)
component CallArrow inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    callback clicked();
    width: 24px;
    height: 48px;
    border-radius: 12px;
    background: open ? Theme.primary : touch.has-hover ? #4a4a50 : #3a3a40;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: "▴";
        color: #ffffff;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component CallButton inherits Rectangle {
    in property <string> icon;
    // The icon of the OS; `icon` is its emoji where the OS has none
    in property <image> symbol;
    in property <string> label;
    in property <bool> off;
    in property <bool> danger;
    // On while pressed (sharing), where the others are on unless off
    in property <bool> latch;
    in property <bool> pressed;
    callback clicked();
    width: danger ? t.preferred-width + 32px : 48px;
    height: 48px;
    border-radius: 24px;
    background: danger ? #d93025 : off ? #ffffff : pressed ? Theme.primary : touch.has-hover ? #4a4a50 : #3a3a40;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: latch ? pressed : !off;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    t := Text {
        text: danger ? label : "";
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.danger: Icon {
        source: root.symbol;
        fallback: root.icon;
        color: root.off ? #1a1a1c : #ffffff;
        size: 22px;
    }
}

component CallTileView inherits Rectangle {
    in property <CallTileRow> tile;
    border-radius: 12px;
    background: #2a2a2e;
    clip: true;
    if tile.has-video && tile.ready: Image {
        width: parent.width;
        height: parent.height;
        source: tile.frame;
        image-fit: contain;
    }
    if !(tile.has-video && tile.ready): Avatar {
        size: min(parent.height * 0.4, 96px);
        initials: tile.initials;
        tint: tile.tint;
    }
    // The name, and the microphone off
    Rectangle {
        x: 8px;
        y: parent.height - self.height - 8px;
        width: label.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: #000000a0;
        label := Text {
            text: (tile.muted ? "🔇 " : "") + tile.name;
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    // Who speaks: a ring
    if tile.speaking: Rectangle {
        border-radius: 12px;
        border-width: 3px;
        border-color: Theme.primary;
    }
}

export component CallStage inherits Rectangle {
    in property <[CallTileRow]> tiles;
    // "Connecting…", or why the call failed; "" while in it
    in property <string> status;
    in property <bool> encrypted;
    in property <bool> microphone;
    in property <bool> camera;
    in property <bool> sharing;
    // The devices of the menu open: "audio" (microphones, speakers), "video" (cameras) or ""
    in property <string> device-menu;
    in property <[DeviceSection]> device-sections;
    // The width of a tile that fits them all (web `tileWidth`), computed in Rust
    pure callback tile-width(int, length, length) -> length;
    callback toggle-microphone();
    callback toggle-camera();
    callback toggle-screen();
    // Opens a device menu ("audio", "video"), or closes it ("")
    callback open-devices(string);
    callback pick-device(string, string);
    callback leave();
    background: #18181b;
    accessible-role: groupbox;
    accessible-label: "Call";

    property <length> gap: 8px;
    property <length> grid-width: self.width - 32px;
    property <length> grid-height: self.height - 112px;
    property <length> tw: tile-width(tiles.length, grid-width, grid-height);
    property <length> th: tw * 9 / 16;
    property <int> columns: max(1, min(tiles.length, floor((grid-width + gap) / max(1px, tw + gap))));
    property <int> rows: max(1, ceil(tiles.length / columns));
    // A shared screen takes the stage (Rust puts it first), the people a centred row of
    // tiles at most 200 px wide under it (web `CallStage`, `STRIP_TILE_WIDTH`)
    property <bool> staged: tiles.length > 0 && tiles[0].screen;
    property <int> strip-count: tiles.length - 1;
    property <length> sw: strip-count > 0 ? max(0px, min(200px, (grid-width - (strip-count + 1) * gap) / strip-count)) : 0px;
    property <length> sh: sw * 9 / 16;
    property <length> stage-height: strip-count > 0 ? grid-height - sh - gap : grid-height;

    for tile[i] in tiles: CallTileView {
        // Rows centred, the last one too
        property <int> line: floor(i / columns);
        property <int> in-line: line == rows - 1 ? tiles.length - line * columns : columns;
        x: !staged ? 16px + (grid-width - in-line * tw - (in-line - 1) * gap) / 2 + mod(i, columns) * (tw + gap)
            : i == 0 ? 16px
            : 16px + (grid-width - strip-count * sw - (strip-count - 1) * gap) / 2 + (i - 1) * (sw + gap);
        y: !staged ? 16px + (grid-height - rows * th - (rows - 1) * gap) / 2 + line * (th + gap)
            : i == 0 ? 16px
            : 16px + stage-height + gap;
        width: !staged ? tw : i == 0 ? grid-width : sw;
        height: !staged ? th : i == 0 ? stage-height : sh;
        tile: tile;
    }
    // Above the grid once someone is in it, else in its middle
    if status != "": Text {
        y: tiles.length > 0 ? 4px : 16px + root.grid-height / 2 - 10px;
        width: root.width;
        text: status;
        color: #ffffff;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        y: root.height - 72px;
        height: 48px;
        alignment: center;
        spacing: 12px;
        if root.encrypted: VerticalLayout {
            alignment: center;
            accessible-role: image;
            accessible-label: "Encrypted call";
            Icon { source: Icons.lock; fallback: "🔒"; color: #ffffff; }
        }
        HorizontalLayout {
            spacing: 2px;
            CallButton {
                icon: root.microphone ? "🎤" : "🔇";
                symbol: root.microphone ? Icons.mic : Icons.mic-off;
                label: "Microphone";
                off: !root.microphone;
                clicked => { root.toggle-microphone(); }
            }
            CallArrow {
                label: "Microphone and speaker";
                open: root.device-menu == "audio";
                clicked => { root.open-devices(root.device-menu == "audio" ? "" : "audio"); }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            CallButton {
                icon: "📷";
                symbol: Icons.video;
                label: "Camera";
                off: !root.camera;
                clicked => { root.toggle-camera(); }
            }
            CallArrow {
                label: "Cameras";
                open: root.device-menu == "video";
                clicked => { root.open-devices(root.device-menu == "video" ? "" : "video"); }
            }
        }
        CallButton {
            icon: "🖥️";
            symbol: Icons.screen;
            label: "Share the screen";
            latch: true;
            pressed: root.sharing;
            clicked => { root.toggle-screen(); }
        }
        CallButton {
            label: "Leave the call";
            danger: true;
            clicked => { root.leave(); }
        }
    }
    if root.device-menu != "": TouchArea {
        clicked => { root.open-devices(""); }
    }
    if root.device-menu != "" && root.device-sections.length > 0: Rectangle {
        width: 300px;
        height: menu-list.preferred-height;
        x: (root.width - self.width) / 2;
        y: root.height - 72px - self.height - 8px;
        border-radius: 10px;
        background: Theme.background;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000030;
        accessible-role: list;
        accessible-label: "Devices";
        // Holds the clicks: they do not reach the TouchArea that closes the menu
        TouchArea { }
        menu-list := VerticalLayout {
            padding: 6px;
            for section in root.device-sections: VerticalLayout {
                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        height: 28px;
                        text: section.title;
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                for row in section.rows: Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    background: row-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: checkbox;
                    accessible-checked: row.checked;
                    accessible-label: row.label;
                    accessible-action-default => { root.pick-device(section.kind, row.id); }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-device(section.kind, row.id); }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            width: 16px;
                            text: row.checked ? "✓" : "";
                            color: Theme.primary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.label;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // Not a speaker: a system that cannot choose its output says nothing (web)
                if section.rows.length == 0: HorizontalLayout {
                    padding-left: 32px;
                    Text {
                        height: 34px;
                        text: "No device";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
